PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/robonity?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=https://robonity.vercel.app

# Gmail SMTP — used for RoboShare's email OTP verification
# Generate an App Password at: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Optional
NODE_ENV=production
