PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/robonity?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=https://robonity.vercel.app

# SendGrid — used for RoboShare's email OTP verification
# GMAIL_USER must be verified as a Single Sender in SendGrid (Settings > Sender Authentication)
GMAIL_USER=your_gmail_address@gmail.com
SENDGRID_API_KEY=your_sendgrid_api_key

# Optional
NODE_ENV=production
